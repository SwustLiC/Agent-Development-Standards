{
  "$schema": "https://opencode.ai/config.json",
  // canary 说明：standards 位于仓库根目录，这里用相对路径演示 OpenCode 的向上查找。
  // 相对 instructions 会从当前目录逐级向上搜索到项目根，
  // 因此无论从仓库根还是 examples/mini 启动，都能命中 standards/python/core.md。
  // vendor 模式的 `.opencode/standards/python/` 布局由 CI 的 vendor.py 冒烟测试覆盖。
  "instructions": ["standards/python/core.md"],
  "formatter": true
}
